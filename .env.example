# Copy this file to .env.local and fill in values from Supabase Dashboard → Project Settings → API
# Never commit .env.local — it is gitignored.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: pinned X post URL for FCFS share step (defaults to Blackwater profile)
# VITE_BLACKWATER_PINNED_POST_URL=https://x.com/blackwater_z26/status/1234567890

# Cloudflare Turnstile — public site key (browser only)
# Local/test always-pass widget: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare Turnstile — secret key (Supabase Edge Function only, NEVER prefix with VITE_)
# Set via: supabase secrets set TURNSTILE_SECRET_KEY=your-secret-key
# Local/test always-pass secret: 1x0000000000000000000000000000000AA
